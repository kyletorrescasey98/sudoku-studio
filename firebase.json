{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "main-site",
    "public": "public",
    "rewrites": [
      {
        "source": "/",
        "destination": "/landing.html"
      },
      {
        "source": "/__/auth/action",
        "destination": "/auth-action.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}